# Copy to .env.local and fill in. `npx supabase status` prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key: safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only. Used to write shared caches (e.g. the streaming-service list).
SUPABASE_SECRET_KEY=
# TMDB "API Read Access Token" from https://www.themoviedb.org/settings/api. Server only.
TMDB_API_TOKEN=
# Web push (VAPID) keys: generate a pair with `npx web-push generate-vapid-keys`. The public one goes to browsers.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Shared secret for /api/cron/daily, which pg_cron calls once a day. Any long random string. Server only.
CRON_SECRET=
