# Copy to .env.local and fill in. `npx supabase status` prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key: safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only. Used to write shared caches (e.g. the streaming-service list).
SUPABASE_SECRET_KEY=
# TMDB "API Read Access Token" from https://www.themoviedb.org/settings/api. Server only.
TMDB_API_TOKEN=
